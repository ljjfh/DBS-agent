# 复制为 .env 后填写。不填任何 key 也能跑（离线模式 + 浏览器语音识别）。

# ---------- 模型（OpenAI 兼容接口）----------
# offline = 内置规则模型；openai_compat = 调用下面的接口
LLM_PROVIDER=offline
LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
LLM_API_KEY=
# 模型名以控制台实际可用的为准，需要支持 Function Calling
LLM_MODEL=hunyuan-turbos-latest
# 诈骗研判用的模型（独立的第二次调用），留空则与主模型相同
LLM_JUDGE_MODEL=
LLM_TIMEOUT=30

# ---------- 腾讯云 ASR（一句话识别）----------
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
ASR_ENDPOINT=asr.intl.tencentcloudapi.com
ASR_REGION=ap-singapore
# 16k_zh_large（普通话+方言+英语）/ 16k_zh-PY（中英粤）/ 16k_en / 16k_ms
ASR_ENGINE=16k_zh_large

# ---------- Agent 与风控（示例值）----------
AGENT_MAX_STEPS=6
RULE_HARD_LIMIT=5000
RULE_HIGH_THRESHOLD=1000
# 冷静期秒数：Demo 用 20，生产可设 600
RULE_COOLDOWN_SECONDS=20
SIGNING_SECRET=change-me-to-a-long-random-string
