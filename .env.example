# Copy to .env and fill in. Runs without any keys (offline mode + browser speech recognition).

# ---------- Model (OpenAI-compatible API) ----------
# offline = built-in rule model; openai_compat = call the API below
LLM_PROVIDER=offline
LLM_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
LLM_API_KEY=
# Use a model name your provider actually offers; it must support Function Calling (tools)
LLM_MODEL=hunyuan-turbos-latest
# Model for the scam assessment (a separate second call); empty = same as the main model
LLM_JUDGE_MODEL=
# Model for the independent verifier (second engine of the dual-engine audit). Empty = the judge model, else the
# main model. A DIFFERENT model makes the two engines more independent.
LLM_VERIFIER_MODEL=
LLM_TIMEOUT=30
# off = disable Qwen's hidden thinking step (much faster). Only for Qwen / vLLM-style servers; leave empty otherwise
LLM_THINKING=

# ---------- Tencent Cloud ASR (SentenceRecognition) ----------
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
ASR_ENDPOINT=asr.intl.tencentcloudapi.com
ASR_REGION=ap-singapore
# 16k_en (English) / 16k_zh (Mandarin) / 16k_zh-PY (Mandarin/English/Cantonese) / 16k_ms (Malay)
# 16k_zh_large is only available on the China endpoint asr.tencentcloudapi.com
ASR_ENGINE=16k_en

# ---------- Agent and risk rules (example values) ----------
AGENT_MAX_STEPS=6
RULE_HARD_LIMIT=5000
RULE_HIGH_THRESHOLD=1000
# Cooling-off threshold for accounts on Standard protection (Enhanced uses RULE_HIGH_THRESHOLD)
RULE_HIGH_THRESHOLD_STANDARD=3000
# Lowering protection (Enhanced -> Standard) is signed and only takes effect after this many seconds.
# 86400 (24 h) is realistic; use e.g. 30 to show it in a demo.
PROTECTION_LOWER_DELAY=86400
# Cooling-off period in seconds: 20 for the demo, e.g. 600 in production
RULE_COOLDOWN_SECONDS=20
SIGNING_SECRET=change-me-to-a-long-random-string

# ---------- Payment authorization ----------
# Every payment is signed on the user's device: with a passkey (the device's own fingerprint / face check) when the
# browser has one, otherwise with a non-extractable browser key. The execution gateway re-verifies it.
# device_key = the above (default, use this for the demo)
# mock       = also accept the old "demo-fingerprint" string (quick scripts only; the gateway then allows unsigned)
AUTH_MODE=device_key
# Websites the server answers to. Passkeys only work on localhost or HTTPS.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
